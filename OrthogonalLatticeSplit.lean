import Mathlib.Algebra.Module.ZLattice.Covolume
import Mathlib.Analysis.InnerProductSpace.Projection.FiniteDimensional
import Mathlib.Algebra.Module.Projective
import Mathlib.LinearAlgebra.Basis.Prod

/-!
# Integral splitting along a rational subspace

For catalog item `projected_lattice_determinant_bound`. The lattice in a subspace
is the full intersection, rather than only the integer span of the selected vectors.
A free projected lattice admits integral lifts of a basis, without requiring those
lifts to be orthogonal to the subspace.
-/

open Set Module

namespace LatticeVolumeInterpolation

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E]

/-- The full lattice intersection with a subspace, in intrinsic coordinates. -/
def sectionLattice (Λ : Submodule ℤ E) (L : Submodule ℝ E) : Submodule ℤ L :=
  Λ.comap (L.subtype.restrictScalars ℤ)

/-- The orthogonal image lattice, in the orthogonal-complement subtype. -/
def orthogonalImageLattice (Λ : Submodule ℤ E) (L : Submodule ℝ E) : Submodule ℤ Lᗮ :=
  Λ.map (Lᗮ.orthogonalProjectionOnto.toLinearMap.restrictScalars ℤ)

/-- The projection as a surjection between the integral modules. -/
def latticeProjection (Λ : Submodule ℤ E) (L : Submodule ℝ E) :
    Λ →ₗ[ℤ] orthogonalImageLattice Λ L :=
  ((Lᗮ.orthogonalProjectionOnto.toLinearMap.restrictScalars ℤ).comp Λ.subtype).codRestrict
    (orthogonalImageLattice Λ L) (fun x => ⟨x, x.property, rfl⟩)

theorem latticeProjection_surjective (Λ : Submodule ℤ E) (L : Submodule ℝ E) :
    Function.Surjective (latticeProjection Λ L) := by
  rintro ⟨y, x, hx, rfl⟩
  exact ⟨⟨x, hx⟩, rfl⟩

/-- The natural inclusion of the full intersection into the ambient lattice. -/
def sectionLatticeInclusion (Λ : Submodule ℤ E) (L : Submodule ℝ E) :
    sectionLattice Λ L →ₗ[ℤ] Λ where
  toFun x := ⟨(x : L), x.property⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

omit [FiniteDimensional ℝ E] in
theorem sectionLattice_discrete (Λ : Submodule ℤ E) [DiscreteTopology Λ]
    (L : Submodule ℝ E) : DiscreteTopology (sectionLattice Λ L) := by
  have hc : Continuous (sectionLatticeInclusion Λ L) :=
    (continuous_subtype_val.comp continuous_subtype_val).subtype_mk _
  apply DiscreteTopology.of_continuous_injective hc
  intro x y h
  apply Subtype.ext
  exact Subtype.ext (congrArg (fun z : Λ => (z : E)) h)

omit [FiniteDimensional ℝ E] in
/-- The intersection lattice spans a subspace generated by ambient lattice vectors. -/
theorem sectionLattice_span_top (Λ : Submodule ℤ E) {X : Set E} (hX : X ⊆ Λ) :
    Submodule.span ℝ (sectionLattice Λ (Submodule.span ℝ X) :
      Set (Submodule.span ℝ X)) = ⊤ := by
  let L := Submodule.span ℝ X
  have himage : L.subtype '' (sectionLattice Λ L : Set L) = (Λ : Set E) ∩ L := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨hy, y.property⟩
    · intro hx
      exact ⟨⟨x, hx.2⟩, hx.1, rfl⟩
  have hspan : Submodule.span ℝ ((Λ : Set E) ∩ L) = L := by
    apply le_antisymm
    · exact Submodule.span_le.mpr (fun x hx => hx.2)
    · exact Submodule.span_mono (fun x hx => ⟨hX hx, Submodule.subset_span hx⟩)
  apply Submodule.map_injective_of_injective L.injective_subtype
  rw [Submodule.map_span, himage, hspan, Submodule.map_top, L.range_subtype]

/-- Integral exactness: the kernel is exactly the full lattice intersection. -/
theorem latticeProjection_eq_zero_iff (Λ : Submodule ℤ E) (L : Submodule ℝ E)
    (x : Λ) : latticeProjection Λ L x = 0 ↔ (x : E) ∈ L := by
  rw [← Subtype.coe_inj]
  change Lᗮ.orthogonalProjectionOnto (x : E) = 0 ↔ (x : E) ∈ L
  rw [Submodule.orthogonalProjectionOnto_eq_zero_iff, Submodule.orthogonal_orthogonal]

/-- A section of the projected lattice splits the ambient integral module. -/
def latticeSplitEquiv (Λ : Submodule ℤ E) (L : Submodule ℝ E)
    (s : orthogonalImageLattice Λ L →ₗ[ℤ] Λ)
    (hs : latticeProjection Λ L ∘ₗ s = LinearMap.id) :
    (sectionLattice Λ L × orthogonalImageLattice Λ L) ≃ₗ[ℤ] Λ := by
  have hs_apply (y) : latticeProjection Λ L (s y) = y := DFunLike.congr_fun hs y
  apply LinearEquiv.ofBijective ((sectionLatticeInclusion Λ L).coprod s)
  constructor
  · rintro ⟨x, y⟩ ⟨x', y'⟩ heq
    have hy : y = y' := by
      have h := congrArg (latticeProjection Λ L) heq
      have hz (z : sectionLattice Λ L) :
          latticeProjection Λ L (sectionLatticeInclusion Λ L z) = 0 :=
        (latticeProjection_eq_zero_iff Λ L _).mpr (z : L).property
      simpa only [LinearMap.coprod_apply, map_add, hz, hs_apply, zero_add] using h
    subst y'
    have hx : x = x' := by
      have h : sectionLatticeInclusion Λ L x = sectionLatticeInclusion Λ L x' :=
        add_right_cancel heq
      apply Subtype.ext
      exact Subtype.ext (congrArg (fun z : Λ => (z : E)) h)
    exact Prod.ext hx rfl
  · intro x
    have hz : latticeProjection Λ L (x - s (latticeProjection Λ L x)) = 0 := by
      simp [hs_apply]
    let z : sectionLattice Λ L :=
      ⟨⟨(x - s (latticeProjection Λ L x) : Λ),
        (latticeProjection_eq_zero_iff Λ L _).mp hz⟩,
        (x - s (latticeProjection Λ L x)).property⟩
    exact ⟨(z, latticeProjection Λ L x), by
      change (x - s (latticeProjection Λ L x)) + s (latticeProjection Λ L x) = x
      exact sub_add_cancel _ _⟩

/-- A free projected lattice has an integral splitting. -/
theorem exists_latticeSplit (Λ : Submodule ℤ E) (L : Submodule ℝ E)
    [Module.Free ℤ (orthogonalImageLattice Λ L)] :
    ∃ s : orthogonalImageLattice Λ L →ₗ[ℤ] Λ,
      latticeProjection Λ L ∘ₗ s = LinearMap.id :=
  (latticeProjection Λ L).exists_rightInverse_of_surjective
    (LinearMap.range_eq_top.mpr (latticeProjection_surjective Λ L))

end
end LatticeVolumeInterpolation
